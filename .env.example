# FIRSAT360 örnek ortam değişkenleri — gerçek değerleri .env dosyasına yazın (.env depoya EKLENMEZ).

# Veritabanı
POSTGRES_PASSWORD=degistirin-uzun-rastgele-parola
DATABASE_URL=postgresql+psycopg://firsat:degistirin-uzun-rastgele-parola@127.0.0.1:5432/firsat360

# Tarayıcı kimliği: mağazalar sizi tanıyabilsin diye iletişim adresi ekleyin.
SCRAPER_USER_AGENT=FIRSAT360Bot/0.1 (+mailto:iletisim@alanadiniz.com)
REQUEST_TIMEOUT_S=20
MIN_REQUEST_INTERVAL_S=4
MAX_PAGES_PER_STORE=8

# Kaynak hatasında yöneticiye bildirim (isteğe bağlı). JSON {"text": "..."} POST edilir (Slack/Discord/Telegram köprüsü).
ALERT_WEBHOOK_URL=

# Canlı taranacak mağazalar (virgülle). Bir mağazayı çıkarmak onu zamanlayıcıdan kaldırır.
LIVE_STORES=a101,bim,sok,migros,tkkoop,hakmar,watsons,metro,bizimtoptan,gratis,rossmann,onur,carrefoursa,file

# Zamanlama: GitHub Actions (.github/workflows/daily.yml) 08:05 ve 00:05; VPS'te cron: 5 8,0 * * * cd backend && python -m firsat360 daily

FEED_EXPORT_PATH=./dist/feed.json
TZ_NAME=Europe/Istanbul

