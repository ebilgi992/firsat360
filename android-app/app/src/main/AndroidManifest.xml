<?xml version="1.0" encoding="utf-8"?>
<!-- Gradle (AGP 8) için paket adı build.gradle.kts içindeki "namespace" alanından gelir.
     build-nogradle.sh bu dosyaya package/uses-sdk ekleyerek derler. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Yalnızca gerekli izinler: ağ (güncel veri, resmî sayfalar) ve ağ türü (Wi-Fi/mobil veri tercihi).
         Konum, kişi, depolama, kesin alarm izni yok. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Yeni katalog ve fiyat alarmı bildirimleri (Android 13+ çalışma zamanında, kullanıcı açınca istenir) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Periyodik kontrolün cihaz yeniden başladıktan sonra sürmesi için (JobScheduler setPersisted) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.firsat360.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Push bildirimine (ntfy) dokununca: firsat360://catalog/<id>, firsat360://store/<id>, firsat360://catalogs/new -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="firsat360" />
            </intent-filter>
        </activity>
        <activity android:name="com.firsat360.app.data.UpdateResultActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="com.firsat360.app.data.CheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.firsat360.app.data.DailyAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="com.firsat360.app.data.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

