        <script>
            var popupLogins = document.querySelectorAll('a.open-login-popup');
            if (popupLogins != null && popupLogins.length > 0) {
                popupLogins.forEach((el) => {
                    el.addEventListener('click', function (ev) {
                        ev.preventDefault();
                        var options = {};
                        options.redirect2Profile = false;
                        options.redirectUrl = el.href;
                        openSinginPopup(options);
                        return false;
                    }, false);
                });
