<div id="signInContainer" class="sign-in">

    <div class="head">
        <div class="name select-false">{{popUpTitle}}</div>
        <div class="icon-sign-in"></div>
    </div>
    <div class="content">
        <div class="inner" :style="{height:(processStep==2 || processStep==3)?'397px':(processStep==5 || processStep==6)?'450px':'390px'}">

            <div class="step-one" v-show="processStep==1">
                <div v-show="!navigating2Registration">
                    <form class="form-group" action="/mc/kataloglarimiz/migros-jet-dijital/247" method="post">

                        <label>Money kampanya ve indirimlerinden faydalanmak için cep telefonu numaranı yazmalısın.</label>
                        <input type="tel" class="mobilePhone" v-model="form.phone" ref="phoneInput" v-mask="'### #######'" placeholder="5XX XXXXXXX" v-on:keyup.enter="validateAndSendOTP">
                        <div class="captcha-wrapper" data-theme="light" data-language="tr">
                        </div>
                        <label class="text-danger">{{savingResult}}</label>
                        <button type="button" class="btn center-block btn-orange btn-lg w-100"
                                :disabled="submitting || isBlocked"
                                v-on:click.stop.prevent="validateAndSendOTP">
                            {{ phoneSendingButtonText }}
                        </button>
                        <svg v-if="isSmallWindow" class="svgPathLine center-block" version="1.1" x="0px" y="0px" width="276px" height="8px" viewBox="0 0 276 8" style="enable-background:new 0 0 276 8;" xml:space="preserve"><line class="line-loader-bg" x1="4" y1="4" x2="272" y2="4" /><line class="line-loader" id="pass-preloader" v-bind:style="{stroke:'#F38A44','stroke-dasharray':otpTightLoaderValue}" v-bind:length="otp.otpTightLoaderLenght" name="line" x1="4" y1="4" x2="272" y2="4" /></svg>
                        <label style="width: 100%; height: 100%; display: flex; justify-content: center; align-items: center;" v-if="otp.otpBlockRemainingSeconds > 0">
                            {{ blockTimerValueString }}
                        </label>

                    <input name="__RequestVerificationToken" type="hidden" value="CfDJ8Mc0TpBk2aFJp10ha3z52qKBVUx1S5W-ANzOEjyqFskVTBW2cXjRDOdBV6OrCBhWyysjpdL-yQObhQBpQ2vvw32KbvPKF5MaUZWd2OicK_CaMfDRHuEeDsiloTC2OjNNI937omeCp7EmufUtIsSHcDk" /></form>
                </div>
                <div v-show="navigating2Registration">

                    <div class="redirect-msg">
                        <div class="content">
                            <div class='redirect-loader'>
                                <svg viewBox='25 25 50 50'><circle class='circularPath' cx='50' cy='50' r='20' fill='none' stroke-width='2' stroke-miterlimit='10'></circle></svg>
                            </div>
                            <p>Kayıt formuna yönlendiriliyorsun.</p>
                        </div>
                    </div>

                </div>
            </div>
            <div class="step-two" v-show="processStep==2">
                <div>
                    <div class="form-group">
                        <div class="phone-verification">
                            <label>Cep Telefonu Doğrulama</label>
                            <label class="phone-number"> {{form.phone}}</label>
                        </div>
                    </div>
                    <div class="line visible-md visible-lg"></div>
                    <div class="form-group" v-if="otp.otpTimeout==false">

                        <div class="phone-password">
                            <label>Cep telefonuna gelen şifreyi aşağıdaki alana girmelisin.</label>
                            <div>
                                <input data-index="0" v-model="otpValues.p0" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel" ref="otpFistInput">
                                <input data-index="1" v-model="otpValues.p1" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="2" v-model="otpValues.p2" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="3" v-model="otpValues.p3" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="4" v-model="otpValues.p4" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="5" v-model="otpValues.p5" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">

                            </div>
                        </div>

                        <label class="text-danger">{{savingResult}}</label>
                        <div class="password-counter">

                            <svg v-if="!isSmallWindow" class="svgPathRec" version="1.1" width="344px" height="94px" viewBox="0 0 344 94" style="enable-background:new 0 0 344 94;" xml:space="preserve"><polyline class="rec-loader-bg" points="2,49.3 2,2 342,2 342,92 2,92 " /><polyline id="pass-preloader" class="rec-loader" v-bind:style="{stroke:'#F38A44','stroke-dasharray':otpLargeLoaderValue}" v-bind:length="otp.otpLargeLoaderLenght" name="rectangle" points="2,49.3 2,2 342,2 342,92 2,92 " /></svg>

                            <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="submitOtp">
                                {{otpSavingButtonText}}
                            </button>
                            <svg v-if="isSmallWindow" class="svgPathLine center-block" version="1.1" x="0px" y="0px" width="276px" height="8px" viewBox="0 0 276 8" style="enable-background:new 0 0 276 8;" xml:space="preserve"><line class="line-loader-bg" x1="4" y1="4" x2="272" y2="4" /><line class="line-loader" id="pass-preloader" v-bind:style="{stroke:'#F38A44','stroke-dasharray':otpTightLoaderValue}" v-bind:length="otp.otpTightLoaderLenght" name="line" x1="4" y1="4" x2="272" y2="4" /></svg>
                            <label style="margin-top:10px" class="pass-count-down">{{otpTimerValueString}}</label>
                        </div>

                    </div>
                    <div class="form-group" v-if="otp.otpTimeout==true">
                        <label class="text-danger">{{resendOtpResult}}</label>
                        <div class="phone-password">
                            <label class="col-md-12">Şifrenizi zamanında giremediniz.</label>

                            <div class="password-counter">
                                <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="resendOtp">
                                    Tekrar gönder
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="step-three" v-show="processStep==3">
                <div>
                    <div class="form-group">
                        <div class="mail-verification">
                            <label>E-Posta Adresi Doğrulama</label>
                            <label class="mail-adress">{{maskedEmail}}</label>
                        </div>
                    </div>
                    <div class="line visible-md visible-lg"></div>
                    <div class="form-group" v-if="otp.otpTimeout==false">

                        <div class="mail-password">
                            <label>E-Posta adresine gelen şifreyi aşağıdaki alana girmelisin.</label>
                            <div>
                                <input data-index="0" v-model="otpEmailValues.p0" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel" ref="otpEmailFistInput">
                                <input data-index="1" v-model="otpEmailValues.p1" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="2" v-model="otpEmailValues.p2" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="3" v-model="otpEmailValues.p3" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="4" v-model="otpEmailValues.p4" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">
                                <input data-index="5" v-model="otpEmailValues.p5" v-on:keyup="otpKeyup($event)" v-mask="'#'" type="tel">

                            </div>
                        </div>
                        <label class="text-danger">{{savingResult}}</label>
                        <div class="password-counter">

                            <svg v-if="!isSmallWindow" class="svgPathRec" version="1.1" width="344px" height="94px" viewBox="0 0 344 94" style="enable-background:new 0 0 344 94;" xml:space="preserve"><polyline class="rec-loader-bg" points="2,49.3 2,2 342,2 342,92 2,92 " /><polyline id="pass-preloader" class="rec-loader" v-bind:style="{stroke:'#F38A44','stroke-dasharray':otpEmailLargeLoaderValue}" v-bind:length="otpEmail.otpLargeLoaderLenght" name="rectangle" points="2,49.3 2,2 342,2 342,92 2,92 " /></svg>

                            <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="submitEmailOtp">
                                {{otpSavingButtonText}}
                            </button>
                            <svg v-if="isSmallWindow" class="svgPathLine center-block" version="1.1" x="0px" y="0px" width="276px" height="8px" viewBox="0 0 276 8" style="enable-background:new 0 0 276 8;" xml:space="preserve"><line class="line-loader-bg" x1="4" y1="4" x2="272" y2="4" /><line class="line-loader" id="pass-preloader" v-bind:style="{stroke:'#F38A44','stroke-dasharray':otpEmailTightLoaderValue}" v-bind:length="otpEmail.otpTightLoaderLenght" name="line" x1="4" y1="4" x2="272" y2="4" /></svg>
                            <label class="pass-count-down">{{otpEmailTimerValueString}}</label>
                        </div>

                    </div>
                    <div class="form-group" v-if="otpEmail.otpTimeout==true">
                        <label class="text-danger">{{resendOtpEmailResult}}</label>
                        <div class="phone-password">
                            <label class="col-md-12">Şifrenizi zamanında giremediniz.</label>
                            <div class="password-counter">
                                <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="resendEmailOtp">
                                    Tekrar gönder
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cardSelectionStep" v-show="processStep===4">
                <p>Giriş yapmak için Money kartınızı aşağıdan seçebilirsiniz.</p>
                <div class="card-content" style="max-height:246px;overflow-y:scroll">
                    <table class="card-desktop">
                        <thead>
                            <tr>
                                <td></td>
                                <td><p>Seç</p></td>

                                <td><p>Kart numarası</p></td>
                                <td><p>Son alışveriş yeri</p></td>
                                <td><p>Tarihi</p></td>
                            </tr>

                        </thead>
                        <tbody>
                            <tr :class="{active:selectedCard==card}" v-for="card in cards" v-on:click="selectedCard=card">
                                <td><label class="label-btn">{{card.cardType}}</label></td>
                                <td>
                                    <div class="radiobox">
                                        <label><input type="radio" name="signin-card-select" v-model="selectedCard" :value="card"><i class="checkmark"></i></label>
                                    </div>

                                </td>

                                <td class="card-number"><p>{{card.cardNo}}</p></td>
                                <td><p>{{card.store}}</p></td>
                                <td><p>{{card.date}}</p></td>
                            </tr>

                        </tbody>
                    </table>
                    <template v-for="card in cards">
                        <table class="card-mobile" align="center" :class="{active:selectedCard==card}" v-on:click="selectedCard=card">
                            <thead>
                                <tr>
                                    <td><p>{{card.cardType}}</p></td>
                                    <td>
                                        <div class="radiobox">
                                            <label>
                                                Seç <input type="radio" name="signin-card-mobile-select" class="radiobox" v-model="selectedCard" :value="card">
                                                <i class="checkmark"></i>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td><p>Kart numarası</p></td>
                                    <td class="card-number"><p>{{card.cardNo}}</p></td>
                                </tr>
                                <tr>
                                    <td><p>Son alışveriş yeri</p></td>
                                    <td><p>{{card.store}}</p></td>
                                </tr>
                                <tr>
                                    <td><p>Tarihi</p></td>
                                    <td><p>{{card.date}}</p></td>
                                </tr>
                            </tbody>
                        </table>

                    </template>
                </div>

                <label class="text-danger col-md-12">{{savingResult}}</label>
                <div class="password-counter">
                    <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="setSelectedCardAndLogin">
                        Tamam
                    </button>
                </div>

            </div>
            <div class="redirectStep" v-show="processStep===5">
                <p>{{redirectMessage}}</p>
            </div>

            <div class="confirmationStep" v-show="processStep===6">
                <div class="content-body">
                    <div class="row" v-html="AckText">
                    </div>
                </div>
                <label class="text-danger col-md-12">{{savingResult}}</label>
                <button class="btn center-block btn-orange btn-lg " type="button" v-bind:disabled="submitting" v-on:click.prevent="setAckTextRead">
                    Okudum
                </button>

            </div>



            <div class="confirmationStep" v-show="processStep===7">
                <div class="content-body">
                    <div class="row" v-html="TOSText">
                    </div>

                    <div class="col-md-12 form-group">
                        <div class="checkbox">
                            <label for="cb-tos-read">
                                <input type="checkbox" class="checkbox" id="cb-tos-read">
                                <i class="checkmark"></i>
                                Üyelik ve Rıza beyanı metnini okudum kabul ediyorum
                            </label>
                        </div>
                    </div>
                    <label class="text-danger col-md-12">{{savingResult}}</label>
                    <button class="btn center-block btn-orange btn-lg" type="button" v-bind:disabled="submitting" v-on:click.prevent="setTOSRead">
                        Devam
                    </button>
                </div>
            </div>


        </div>
    </div>
    <button class="popup-close-button"></button>
</div>
<div class="signin-kvkk mc-popup min-width">
