<script>
    const MoneySignInURLS = {
        AccountValidateAndSendOTP: '/Account/ValidateAndSendOTP',
        AccountResendOTP: '/Account/ResendOTP',
        AccountResendEmailOTP: '/Account/ResendOTP',
        AccountLogin: '/Account/Login',
        AccountLoginEmail: '/Account/LoginEmail',
        AccountSetSelectedCardAndLogin: '/Account/SetSelectedCardAndLogin',
        ProfileIndex: '/profilim',
        AccountSetTOS: '/Account/SetTOS',
